# Copy to /etc/gender-healthcare/backend.env on the server.
# Keep real values outside the repository and restrict the file to the service user.
SPRING_PROFILES_ACTIVE=prod
APP_NAME=GenderHealthCare
APP_PORT=8085
APP_ADDRESS=127.0.0.1

DB_URL=jdbc:mysql://127.0.0.1:3306/genderhealthcare
DB_USERNAME=change-me
DB_PASSWORD=change-me
JPA_DDL_AUTO=validate

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-google-client-id

VNPAY_TMN_CODE=replace-with-vnpay-tmn-code
VNPAY_HASH_SECRET=replace-with-vnpay-hash-secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-frontend.example.com/user/booking
VNPAY_IPN_URL=https://your-backend.example.com/api/v1/payments/vnpay/ipn

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

ZOOM_CLIENT_ID=replace-with-zoom-client-id
ZOOM_CLIENT_SECRET=replace-with-zoom-client-secret
ZOOM_ACCOUNT_ID=replace-with-zoom-account-id

CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
LOG_LEVEL_ROOT=INFO
