# Production backend environment for Docker Compose on the VPS.
# Keep the real file outside Git and restrict it to the deployment user.
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8085
APP_ADDRESS=0.0.0.0

DB_URL=jdbc:mysql://database:3306/genderhealthcare?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_NAME=genderhealthcare
DB_USERNAME=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_ROOT_PASSWORD=replace-with-db-root-password
JPA_DDL_AUTO=validate
SPRING_ALLOW_CIRCULAR_REFERENCES=false

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=https://s-health.xyz,https://www.s-health.xyz

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-login
MAIL_PASSWORD=replace-with-smtp-key
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@s-health.xyz

PAYOS_CLIENT_ID=replace-with-payos-client-id
PAYOS_API_KEY=replace-with-payos-api-key
PAYOS_CHECKSUM_KEY=replace-with-payos-checksum-key
PAYOS_API_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=https://s-health.xyz/payment
PAYOS_CANCEL_URL=https://s-health.xyz/payment
PAYOS_WEBHOOK_URL=https://api.s-health.xyz/api/v1/payments/payos/webhook
PAYOS_CONNECT_TIMEOUT_SECONDS=5
PAYOS_READ_TIMEOUT_SECONDS=10

CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

ZOOM_CLIENT_ID=replace-with-zoom-client-id
ZOOM_CLIENT_SECRET=replace-with-zoom-client-secret
ZOOM_ACCOUNT_ID=replace-with-zoom-account-id