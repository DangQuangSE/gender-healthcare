[Unit]
Description=Gender Health Care backend
After=network.target

[Service]
Type=simple
User=genderhealthcare
Group=genderhealthcare
WorkingDirectory=/var/www/gender-healthcare/current
EnvironmentFile=-/etc/gender-healthcare/backend.env
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /var/www/gender-healthcare/current/be.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
