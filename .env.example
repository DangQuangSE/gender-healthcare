# Local backend environment. Do not commit a file containing real secrets.
SPRING_PROFILES_ACTIVE=local
APP_PORT=8085
APP_ADDRESS=0.0.0.0

DB_URL=jdbc:mysql://localhost:3306/genderhealthcare
DB_NAME=genderhealthcare
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
JPA_DDL_AUTO=update
SPRING_ALLOW_CIRCULAR_REFERENCES=true

# Optional demo dataset. Keep disabled for normal or production environments.
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=replace-with-a-demo-only-password

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-login
MAIL_PASSWORD=replace-with-smtp-key
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

PAYOS_CLIENT_ID=replace-with-payos-client-id
PAYOS_API_KEY=replace-with-payos-api-key
PAYOS_CHECKSUM_KEY=replace-with-payos-checksum-key
PAYOS_API_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:5173/payment
PAYOS_CANCEL_URL=http://localhost:5173/payment
PAYOS_WEBHOOK_URL=http://localhost:8085/api/v1/payments/payos/webhook
PAYOS_CONNECT_TIMEOUT_SECONDS=5
PAYOS_READ_TIMEOUT_SECONDS=10

CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

ZOOM_CLIENT_ID=replace-with-zoom-client-id
ZOOM_CLIENT_SECRET=replace-with-zoom-client-secret
ZOOM_ACCOUNT_ID=replace-with-zoom-account-id
