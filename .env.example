# Copy this file to .env for local development. Never commit the real .env.

SPRING_PROFILES_ACTIVE=local
APP_NAME=GenderHealthCare
APP_PORT=8085
APP_ADDRESS=0.0.0.0

DB_URL=jdbc:mysql://localhost:3306/genderhealthcare
DB_USERNAME=change-me
DB_PASSWORD=change-me
JPA_DIALECT=org.hibernate.dialect.MySQLDialect
JPA_DDL_AUTO=update
SPRING_ALLOW_CIRCULAR_REFERENCES=true

# Use a random value with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

GOOGLE_CLIENT_ID=replace-with-google-client-id

VNPAY_TMN_CODE=replace-with-vnpay-tmn-code
VNPAY_HASH_SECRET=replace-with-vnpay-hash-secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/user/booking
# Use the publicly reachable compatibility callback when enabling VNPay callbacks.
VNPAY_IPN_URL=http://localhost:8085/api/payment/vnpay/vnpay-return

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

ZOOM_CLIENT_ID=replace-with-zoom-client-id
ZOOM_CLIENT_SECRET=replace-with-zoom-client-secret
ZOOM_ACCOUNT_ID=replace-with-zoom-account-id

MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=15MB
CACHE_TYPE=caffeine
SPRING_BEANS_LOG_LEVEL=INFO
LOG_LEVEL_ROOT=INFO

# Comma-separated browser origins. Do not use * with credentials enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173
